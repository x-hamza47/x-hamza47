<svg width="100%" viewBox="0 0 900 200" xmlns="http://www.w3.org/2000/svg" role="img">
  <title>Download Dossier</title>
  <desc>A terminal-style CV/resume download panel matching the HAMZA.OS theme.</desc>

  <defs>
    <linearGradient id="dossierBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#150029"/>
      <stop offset="100%" stop-color="#0a0014"/>
    </linearGradient>
    <linearGradient id="dossierGlow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#A855F7" stop-opacity="0"/>
      <stop offset="50%" stop-color="#A855F7" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#A855F7" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="btnGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#7C3AED"/>
      <stop offset="100%" stop-color="#C084FC"/>
    </linearGradient>
    <filter id="dGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <rect width="900" height="200" rx="10" fill="url(#dossierBg)" stroke="#A855F7" stroke-width="1" opacity="0.95"/>
  <rect x="0" y="0" width="900" height="3" fill="url(#dossierGlow)">
    <animate attributeName="opacity" values="0.4;1;0.4" dur="3s" repeatCount="indefinite"/>
  </rect>

  <!-- scanline -->
  <rect width="900" height="3" fill="#A855F7" opacity="0.06">
    <animate attributeName="y" values="0;200;0" dur="6s" repeatCount="indefinite"/>
  </rect>

  <!-- corner brackets -->
  <g stroke="#A855F7" stroke-width="2" fill="none" opacity="0.8">
    <path d="M20,20 L45,20 M20,20 L20,45"/>
    <path d="M880,20 L855,20 M880,20 L880,45"/>
    <path d="M20,180 L45,180 M20,180 L20,155"/>
    <path d="M880,180 L855,180 M880,180 L880,155"/>
  </g>

  <!-- left: icon -->
  <g transform="translate(75,100)">
    <circle r="34" fill="none" stroke="#C084FC" stroke-width="1" opacity="0.5" stroke-dasharray="2 5">
      <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="14s" repeatCount="indefinite"/>
    </circle>
    <circle r="24" fill="#1a0533" stroke="#A855F7" stroke-width="2"/>
    <g transform="translate(-11,-13)" fill="#e9d5ff">
      <path d="M2 0 H14 L20 6 V24 H2 Z" fill="none" stroke="#e9d5ff" stroke-width="1.6"/>
      <path d="M14 0 V6 H20 Z" fill="#e9d5ff" opacity="0.7"/>
      <line x1="5.5" y1="11" x2="16.5" y2="11" stroke="#e9d5ff" stroke-width="1.3"/>
      <line x1="5.5" y1="15" x2="16.5" y2="15" stroke="#e9d5ff" stroke-width="1.3"/>
      <line x1="5.5" y1="19" x2="12.5" y2="19" stroke="#e9d5ff" stroke-width="1.3"/>
    </g>
    <path d="M-8 34 L0 42 L8 34" fill="none" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <animate attributeName="transform" values="translate(0,0);translate(0,4);translate(0,0)" dur="2s" repeatCount="indefinite"/>
    </path>
  </g>

  <!-- middle: text -->
  <g font-family="JetBrains Mono, monospace">
    <text x="150" y="72" font-size="12" fill="#A855F7" letter-spacing="2">MY RESUME</text>
    <text x="150" y="102" font-size="24" font-weight="700" fill="#f3e8ff" filter="url(#dGlow)">CV Download</text>
    <text x="150" y="128" font-size="13" fill="#7c7c94">get a copy of my full resume as a PDF</text>
  </g>

  <!-- right: download button -->
  <g transform="translate(660,70)">
    <rect width="180" height="60" rx="8" fill="url(#btnGrad)">
      <animate attributeName="opacity" values="0.9;1;0.9" dur="2.5s" repeatCount="indefinite"/>
    </rect>
    <rect width="180" height="60" rx="8" fill="none" stroke="#f3e8ff" stroke-width="1" opacity="0.4"/>
    <g transform="translate(28,18)" stroke="#0a0014" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2 V16"/>
      <path d="M6 11 L12 17 L18 11"/>
      <path d="M4 21 H20"/>
    </g>
    <text x="105" y="35" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="15" font-weight="700" fill="#0a0014">DOWNLOAD</text>
  </g>
</svg>
